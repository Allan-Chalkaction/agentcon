{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(rm *)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Read(./**/credentials.json)",
      "Read(./**/secrets.*)",
      "Write(./prod.config.*)",
      "Write(./production.*)",
      "Write(./**/prod.config.*)"
    ]
  }
}
